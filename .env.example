# SMTP settings for real email delivery
# You can use either SMTP_* or EMAIL_* variable names.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# or
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM="Mela Celebrations <no-reply@melacelebrations.com>"
EMAIL_REPLY_TO=melacelebrations@gmail.com
# Optional dashboard link for the invoice email
INVOICE_URL=http://localhost:5173/dashboard

# MongoDB Config
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/mela-celebrations
MONGODB_DB_NAME=mela-celebrations

# JWT Secret Key
JWT_SECRET=your-random-jwt-secret-key-goes-here

# CORS Origin Allowed
ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare R2 Storage Configurations
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
